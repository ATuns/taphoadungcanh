# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Vercel Blob Store configuration for Tạp Hóa Dung Cảnh database (taphoadungcanh-blob)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Optional store owner passcode override for server-side authentication
STORE_ADMIN_PASSCODE=
